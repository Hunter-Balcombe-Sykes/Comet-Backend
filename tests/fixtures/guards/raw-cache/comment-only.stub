// allowlist acquired its bogus IndividualProfileController entry); a token
// scanner discards T_COMMENT/T_DOC_COMMENT before matching and must produce
// zero hits.
// Never call Cache::put() directly here — go through UserCacheService.
function noop(): void
{
    // also never Cache::forget('x') in this function body
}
