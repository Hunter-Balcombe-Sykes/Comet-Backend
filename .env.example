APP_NAME=Laravel
APP_ENV=local
APP_KEY=EXAMPLE
APP_DEBUG=false
APP_URL=http://localhost:8000

# Dashboard SPA address — distinct from APP_URL (the API backend). Drives
# cross-origin email links + the CORS allow-list. Prod: https://app.partna.au
FRONTEND_URL=http://localhost:5173

# Public mini-site domain. Individual sites resolve as {handle}.{PARTNA_PUBLIC_DOMAIN}.
# Production: partna.au. Local dev: leave unset to fall through to APP_URL host.
# Legacy fallback SIDEST_PUBLIC_DOMAIN is also read (deprecated).
# PARTNA_PUBLIC_DOMAIN=partna.au

# Marketing site URL — used in email footers and branding. Override per-env if
# a staging/preview marketing site URL is needed.
PARTNA_MARKETING_URL=https://partna.au

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Nightwatch — observability. Slow-route / slow-query / slow-job alert
# thresholds are set in the Nightwatch dashboard, not here. The knobs below
# control what events are captured and shipped. See config/nightwatch.php.
NIGHTWATCH_TOKEN=your-nightwatch-token-here
# NIGHTWATCH_ENABLED=true
# NIGHTWATCH_DEPLOY=
# NIGHTWATCH_CAPTURE_EXCEPTION_SOURCE_CODE=true
# NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=false
# NIGHTWATCH_REDACT_PAYLOAD_FIELDS=_token,password,password_confirmation
# NIGHTWATCH_REDACT_HEADERS=Authorization,Cookie,Proxy-Authorization,X-XSRF-TOKEN
# Sampling rates (1.0 = all, 0.1 = 10%). Drop request rate first under load; keep exceptions at 1.0.
# NIGHTWATCH_REQUEST_SAMPLE_RATE=1.0
# NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
# NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
# NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=1.0
# Filtering — drop noisy event categories once volume is high.
# NIGHTWATCH_IGNORE_CACHE_EVENTS=false
# NIGHTWATCH_IGNORE_QUERIES=false
# NIGHTWATCH_IGNORE_MAIL=false
# NIGHTWATCH_IGNORE_NOTIFICATIONS=false
# NIGHTWATCH_IGNORE_OUTGOING_REQUESTS=false
# NIGHTWATCH_LOG_LEVEL=debug
# Ingest agent (Laravel Cloud runs the daemon locally).
# NIGHTWATCH_INGEST_URI=127.0.0.1:2407
# NIGHTWATCH_INGEST_TIMEOUT=0.5
# NIGHTWATCH_INGEST_CONNECTION_TIMEOUT=0.5
# NIGHTWATCH_INGEST_EVENT_BUFFER=500

# Horizon dashboard. The auth gate (AppServiceProvider::authorizeHorizonRequest)
# is open in non-production and sealed in production by default. To allow
# production access, set BOTH credentials below — the dashboard then requires
# HTTP Basic auth. Leaving either unset keeps prod sealed. Use a long random
# password; this gates access to job payloads and a retry button.
# HORIZON_DASHBOARD_USERNAME=
# HORIZON_DASHBOARD_PASSWORD=

# Horizon long-wait notifications. Thresholds are per-queue in config/horizon.php
# 'waits'. These alert on queue *backlog* (jobs sitting too long); Nightwatch
# already covers job *exceptions*. Mail and Slack are independent.
# HORIZON_NOTIFICATION_EMAIL=
# HORIZON_NOTIFICATION_SLACK_WEBHOOK=
# HORIZON_NOTIFICATION_SLACK_CHANNEL=

# Horizon dashboard URL — default '/horizon'. Set HORIZON_DOMAIN to pin the
# dashboard to a specific subdomain (useful when the API is behind multiple hosts).
# HORIZON_PATH=horizon
# HORIZON_DOMAIN=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Default Redis queue-connection tuning (config/queue.php) — safe defaults shown.
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=360   # must exceed the longest job $timeout (300s) — 60s margin
# REDIS_QUEUE_BLOCK_FOR=5   # BLPOP wait in seconds; never 0 (blocks SIGTERM, breaks deploys)
# QUEUE_FAILED_DRIVER=database-uuids

# Must not be a failover-chained store: the analytics fail-open escalation
# (EscalatesRepeatedFaults) only fires when a cache fault throws, and 'failover'
# swallows it. Guarded by tests/Feature/Architecture/CacheStoreFailoverGuardTest.php.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Separate cache vs sessions vs queues vs locks. DB 0 (REDIS_DB) is reserved
# for Horizon/queue traffic — keep cache OFF it: Cache::flush() issues a raw
# FLUSHDB that is NOT key-prefix-scoped and would wipe Horizon job state.
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_CACHE_LOCKS_DB=4

# LZ4 compression on the cache connection. Measured 2026-07-28 on dev (phpredis 6.3.0):
# whole cache keyspace 157,968 B → 45,560 B (3.47×). No igbinary — Laravel serializes to a
# string before phpredis sees the value, so a serializer measured as a no-op (8,248 B vs 8,256 B).
# Turning it ON needs no flush; turning it OFF needs a CACHE_PREFIX bump in the same deploy,
# because compressed bytes read without the flag unserialize() to a cached falsy hit.
# See docs/superpowers/specs/2026-07-28-redis-cache-compression-design.md
REDIS_CACHE_COMPRESSION=false

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@partna.au"
MAIL_FROM_NAME="${APP_NAME}"

# Optional mail-transport fallback + Slack ops notifications (Horizon long-wait
# alerts). All resolve to null when unset — the feature is simply off.
# POSTMARK_API_KEY=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# In-app feedback system (see docs/superpowers/plans/2026-05-25-feedback-system.md).
# Comma-separated email recipients for submission notifications.
# Empty → submissions still persist; email job logs a warning and returns.
FEEDBACK_NOTIFY_EMAILS=
# SHA256 pepper for IP hashing. Generate per env: `openssl rand -hex 32`.
# Never share between envs; never commit. Empty → ip_hash stored NULL.
FEEDBACK_IP_HASH_PEPPER=
# Per-user rate limits. Env-tunable without a code change.
FEEDBACK_RATE_LIMIT_HOUR=10
FEEDBACK_RATE_LIMIT_DAY=30
FEEDBACK_DUPLICATE_WINDOW=60

# Resend HTTP API key — required when MAIL_MAILER=resend. Get from
# https://resend.com/api-keys. Use a "Full access" key so bounce/complaint
# webhooks can be wired up later.
RESEND_API_KEY=

# Resend webhook signing secret (Svix). Copy from Resend Dashboard → Webhooks →
# (endpoint) → Signing Secret. Format: `whsec_<base64>`. Verifies the signature on
# POST /internal/webhooks/resend (bounce/complaint events → send-time suppression).
# Without it that endpoint returns 503 (fail-closed). Subscribe the endpoint to at
# least email.bounced + email.complained.
RESEND_WEBHOOK_SECRET=

# Supabase Send Email Hook signing secret. Set this from the Supabase
# Dashboard → Authentication → Hooks → Send Email Hook page. Format:
# `v1,whsec_<base64-bytes>`. Without it, /internal/email-hooks/supabase
# returns 503 (fail-closed). The space-separated multi-signature support in
# StandardWebhookVerifier parses multiple signatures on the INBOUND header
# (sender-side rotation) — Supabase holds one secret per hook and doesn't
# dual-sign, so this does NOT give us zero-downtime rotation. Rotating this
# secret means a brief window of 401s; see docs/runbooks/secret-rotation.md.
SUPABASE_EMAIL_HOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media disk (Cloudflare R2 / Laravel Cloud Object Storage)
# All images AND videos (originals, MP4 variants, posters) go in this bucket.
MEDIA_DISK_KEY=
MEDIA_DISK_SECRET=
MEDIA_DISK_REGION=auto
MEDIA_DISK_BUCKET=sidest-media
MEDIA_DISK_URL=https://media.yourdomain.com
MEDIA_DISK_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
MEDIA_DISK_PATH_STYLE=false
PARTNA_MEDIA_DISK=media

VITE_APP_NAME="${APP_NAME}"

DB_CONNECTION=pgsql
DB_HOST=EXAMPLE
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=EXAMPLE
DB_SSLMODE=require
DB_SEARCH_PATH=public,core,site,notifications,analytics

SUPABASE_URL=EXAMPLE
SUPABASE_ANON_KEY=EXAMPLE
SUPABASE_JWKS_URL=EXAMPLE
SUPABASE_JWT_ISSUER=EXAMPLE
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWKS_CACHE_SECONDS=3600
SUPABASE_JWKS_FAIL_CLOSED=true
# Reject a validated JWT that carries no session_id (SEC-2). Such a token can never be
# revoked, so "sign out everywhere" and admin force-logout silently do nothing for it.
# Default true (fail-closed). This is the INCIDENT REVERT PATH: if Supabase ever mints
# legitimate tokens without the claim, set this to false to restore pass-through with no
# deploy. Watch for the jwt.missing_session_id log line before/after flipping it.
SUPABASE_REQUIRE_SESSION_ID=true
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_HOOK_SECRET=
SUPABASE_ADMIN_BASE_URL=

# MFA windows and brute-force protection (see config/partna.php mfa block)
SIDEST_MFA_FRESH_WINDOW_SECONDS=300
SIDEST_MFA_UNENROLL_WINDOW_SECONDS=60
SIDEST_MFA_VERIFY_MAX_FAILURES=5
SIDEST_MFA_VERIFY_WINDOW_SECONDS=300
SIDEST_MFA_REQUIRE_FRESH_AAL2_FOR_PROFILE_UPDATE=false

PARTNA_SOFT_DELETE_RETENTION_DAYS=30
PARTNA_THROTTLE_ENABLED=true

# Comma-separated browser origins allowed to call the API via CORS. No spaces,
# no trailing slashes, no paths. Wildcard subdomains (*.partna.au visitor sites,
# Shopify admin hosts) are matched by patterns in config/cors.php and do NOT
# belong here. Localhost entries belong in dev only.
# Prod example: https://partna.au,https://www.partna.au,https://app.partna.au
# Dev example:  https://partna.au,https://www.partna.au,https://app.partna.au,https://dev-app.partna.au,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
PARTNA_FRONTEND_ORIGINS=
PARTNA_WAITLIST_ENABLED=false
PARTNA_EARLY_ACCESS_RETENTION_DAYS=730

# Pre-Account Sites (site-first signup + staff marketing builds).
PARTNA_PRE_ACCOUNT_EXPIRY_DAYS=30
PARTNA_PRE_ACCOUNT_MAX_UNCLAIMED_PER_IP=3

# Image upload limits
PARTNA_IMAGE_MAX_UPLOAD_KB=10240
PARTNA_GALLERY_IMAGE_MAX=5
PARTNA_CONTENT_IMAGE_MAX=5

# Logo background removal + SVG vectorization (self-hosted Cloudflare Worker + Container).
# Ships DISABLED. Enable only once partna-logo-processor is deployed and the URL + token
# point at it. On any processor failure the job falls back to the standard WebP pipeline.
PARTNA_LOGO_REMOVAL_ENABLED=false
PARTNA_LOGO_PROCESSOR_URL=
PARTNA_LOGO_PROCESSOR_TOKEN=
# PARTNA_LOGO_PROCESSOR_TIMEOUT=120

# Image processing variants
PARTNA_IMAGE_TARGET_KB=500
PARTNA_IMAGE_QUALITY=92
PARTNA_IMAGE_MIN_QUALITY=60
PARTNA_IMAGE_MAXIMIZED_QUALITY=92

# Video uploads (availability is gated by the `video_uploads` feature flag, not an env var)
PARTNA_VIDEO_MAX_UPLOAD_KB=204800        # 200 MB — generous for a 30s 4K phone clip
PARTNA_VIDEO_MAX_DURATION_SECONDS=30     # 30s — short autoplay clips
# Defaults assume ffmpeg/ffprobe on $PATH (local dev via Homebrew/Herd).
# On Laravel Cloud, override in the dashboard with the absolute paths
# installed by deploy/ffmpeg.sh:
#   PARTNA_FFMPEG_BINARY=/var/www/html/bin/ffmpeg/ffmpeg
#   PARTNA_FFPROBE_BINARY=/var/www/html/bin/ffmpeg/ffprobe
PARTNA_FFMPEG_BINARY=ffmpeg
PARTNA_FFPROBE_BINARY=ffprobe
PARTNA_VIDEO_QUEUE_CONNECTION=redis_video
PARTNA_VIDEO_QUEUE_NAME=videos
PARTNA_VIDEO_QUEUE_TIMEOUT=3600
PARTNA_VIDEO_QUEUE_RETRY_AFTER=3600
# PARTNA_VIDEO_QUEUE_BLOCK_FOR=5   # BLPOP wait in seconds; never 0 (blocks SIGTERM, breaks deploys)
PARTNA_VIDEO_OPTIMIZED_RESOLUTION=1280x720
PARTNA_VIDEO_OPTIMIZED_BITRATE=2000
PARTNA_VIDEO_OPTIMIZED_AUDIO_BITRATE=128
PARTNA_VIDEO_MAXIMIZED_RESOLUTION=1920x1080
PARTNA_VIDEO_MAXIMIZED_BITRATE=5000
PARTNA_VIDEO_MAXIMIZED_AUDIO_BITRATE=192

PARTNA_NOTIFICATIONS_EMAIL_ENABLED=false
# Queue lane for transactional confirmation emails (enquiry + subscription).
# Default 'notifications' matches the Horizon supervisor-notifications lane.
PARTNA_QUEUE_NOTIFICATIONS=notifications
# PARTNA_QUEUE_MAIL=mail
# PARTNA_QUEUE_CLOUDFLARE=cloudflare
# R3-CACHE-1: lowest-priority lane for ReconcilePlatformTakedownJob's bulk purge
# fan-out (appended last in horizon.php supervisor-1's queue list).
# PARTNA_QUEUE_CLOUDFLARE_BULK=cloudflare_bulk
# PARTNA_QUEUE_CACHE_WARM=cache-warm
# PARTNA_QUEUE_IMAGES=images
# PARTNA_QUEUE_STREAMING=streaming
# PARTNA_QUEUE_SCRAPING=scraping
# PARTNA_SCRAPING_QUEUE_RETRY_AFTER=660  # must exceed MenuFetchJob $timeout (600s)
# PARTNA_SCRAPING_QUEUE_BLOCK_FOR=5  # BLPOP wait in seconds; never 0 (blocks SIGTERM, breaks deploys)
# PARTNA_QUEUE_PLATFORM_REFRESH=platform_refresh

# Platform connection refresh (SCALE-1) — cadence, circuit-breaker, and staleness alarm.
# Safe defaults in config/partna.php; listed here for incident-response discoverability.
# PARTNA_REFRESH_DEFAULT_TTL=86400
# PARTNA_REFRESH_MAX_FAILURES=10
# PARTNA_REFRESH_RATE_DEFAULT=60
# PARTNA_REFRESH_BACKLOG_GRACE=2
# PARTNA_REFRESH_BACKLOG_THRESHOLD=500
# RV-5: per-platform-per-run dispatch cap + stagger for the hourly fan-out.
# PARTNA_REFRESH_MAX_PER_PLATFORM=250
# PARTNA_REFRESH_STAGGER_WINDOW=2700
# PARTNA_REFRESH_MAX_STAGGER=10
# Highlights picker snapshot freshness (LIFE-21..24). 0 = always live-fetch.
# PARTNA_HIGHLIGHTS_SNAPSHOT_TTL=86400
PARTNA_REFRESH_ITUNES_CACHE_TTL=21600
PARTNA_REFRESH_YTIMG_POOL=10
PARTNA_REFRESH_PLACES_POOL=5
PARTNA_REFRESH_FETCH_MANY_POOL=6
PARTNA_REFRESH_CONDITIONAL_ENABLED=true

# ── Operational tuning knobs ─────────────────────────────────
# All have safe defaults in config/partna.php — listed here (commented)
# for discoverability during incident response. Uncomment to override.

# Cache TTLs (seconds)
# Handle lifecycle tuning (days)
# SIDEST_HANDLE_RECLAIM_DAYS=14
# SIDEST_HANDLE_REDIRECT_DAYS=90
# SIDEST_HANDLE_SUBDOMAIN_COOLDOWN_DAYS=30
# SIDEST_HANDLE_AUDIT_RETENTION_YEARS=7
# Years before PII email/handle snapshots on audit.user_deletion_audit +
# audit.data_export_audit are redacted in place (B8 PRIV-2/PRIV-3). Floor 1yr.
# PARTNA_AUDIT_PII_RETENTION_YEARS=7

# SIDEST_PUBLIC_PROFILE_RESOLVE_CACHE_TTL=30
# SIDEST_PUBLIC_PROFILE_SLOW_REQUEST_THRESHOLD_MS=1000
# SIDEST_PUBLIC_PROFILE_CACHE_TTL=60
# SIDEST_RATE_LIMIT_PUBLIC_PROFILE_PER_MINUTE=60
# Public client-side analytics beacon endpoint (defaults to APP_URL + /api/analytics).
# PARTNA_PUBLIC_ANALYTICS_ENDPOINT=https://api.partna.au/api/analytics
# PARTNA_CACHE_TTL_PUBLIC_PAYLOAD=900
# PARTNA_CACHE_TTL_ANALYTICS_SHORT=300
# PARTNA_CACHE_TTL_AUTH_ID_LOOKUP=1800
# PARTNA_CACHE_TTL_PROFESSIONAL_MODEL=60
# PARTNA_CACHE_TTL_PROFESSIONAL_HANDLE_LOOKUP=3600
# PARTNA_CACHE_TTL_WEBHOOK_IDEMPOTENCY=86400
# PARTNA_CACHE_TTL_EMAIL_BRAND=86400
# Hourly cache hit-rate SLO (AggregateCacheMetricsJob -> Nightwatch). A hit rate is
# capped at 1 - 1/(lambda * TTL), so 90% on a 60s-TTL key needs ~10 reads/key/minute.
# Low-traffic environments should raise MIN_SAMPLE rather than lower the target, so
# thin buckets are ignored instead of alerting every hour.
# The target is per prefix, because the ceiling follows each prefix's TTL: site is
# public_payload at 900s, pro is professional_model at 60s. MIN_HIT_RATE is only the
# fallback for prefixes with no per-prefix var.
# PARTNA_CACHE_SLO_PREFIXES=site,pro
# PARTNA_CACHE_SLO_MIN_HIT_RATE=0.9
# PARTNA_CACHE_SLO_MIN_HIT_RATE_SITE=0.90
# PARTNA_CACHE_SLO_MIN_HIT_RATE_PRO=0.80
# PARTNA_CACHE_SLO_MIN_SAMPLE=10
# Set false to make SWR cache rebuilds run in-request again (ops kill-switch).
# PARTNA_CACHE_SWR_DEFER_RECOMPUTE=true
# PARTNA_NOTIFICATIONS_LISTING_CACHE_TTL=15

# Retention windows (days)
# PARTNA_ANALYTICS_RAW_EVENT_RETENTION_DAYS=90

# Rate limits / batch sizes
# PARTNA_ENQUIRY_NOTIFY_PER_HOUR=10
# PARTNA_NOTIFICATIONS_BATCH_CHUNK_SIZE=200
# PARTNA_STREAMING_MAX_LIVE_CHECK_PER_SITE=5
# PARTNA_VISITOR_CONFIRMATION_PER_HOUR=5
# R3-SCALE-2: half of Resend's documented 10 req/s PER-TEAM cap (shared with
# every transactional send) — a broadcast must yield to transactional mail.
# PARTNA_MAIL_BROADCAST_PER_SECOND=5

# R3-CACHE-1: takedown bulk-purge pacing. 0 = off (the cloudflare_bulk lane's
# strict priority already isolates real-time purges); non-zero staggers
# dispatch further, capped at max-delay. ~15s is the derived sustainable value
# — see config/partna.php 'cache.bulk_purge_stagger_seconds'.
# PARTNA_CACHE_BULK_PURGE_STAGGER_SECONDS=0
# PARTNA_CACHE_BULK_PURGE_MAX_DELAY_SECONDS=3600
# PARTNA_CACHE_BULK_PURGE_VOLUME_WARNING_THRESHOLD=1000

# Image / media limits
# PARTNA_IMAGE_MAX_PIXELS=24000000
# PARTNA_MEDIA_LEDGER_WINDOW_DAYS=30
# PARTNA_MEDIA_GC_MIN_AGE_HOURS=24
# PARTNA_PLATFORM_GC_MIN_AGE_HOURS=24
# PARTNA_PLATFORM_GC_DELETED_GRACE_DAYS=7
# PARTNA_PLATFORM_GC_MAX_PER_RUN=200
# PARTNA_PLATFORM_GC_MAX_ORPHAN_RATIO=0.25
# PARTNA_PLATFORM_GC_ANOMALY_FLOOR=20

# Outbound-fetch budget (SafeUrlFetcher — every custom-link/platform-scraper fetch)
# PARTNA_HTTP_FETCH_TIMEOUT_SECONDS=8
# PARTNA_HTTP_FETCH_MAX_REDIRECTS=5
# PARTNA_HTTP_CONNECT_TIMEOUT_SECONDS=3
# PARTNA_CONNECT_BUDGET_SECONDS=20
# PARTNA_REFRESH_BUDGET_SECONDS=90

# Deferred-connect rollout (Unit 11 W6) — comma-separated platform slugs from
# {spotify,bandcamp,pinterest,strava,twitch,vimeo,youtube,youtube-music}.
# Empty (default) = fully synchronous everywhere, zero behaviour change.
# PARTNA_CONNECT_DEFERRED=
# Queue lane ConnectFetchJob runs on (must match a Horizon supervisor).
# PARTNA_QUEUE_PLATFORM_CONNECT=platform_connect

# Session tracking (TokenRevocationService — Redis session_id blocklist + Active Sessions)
# PARTNA_SESSION_TOUCH_INTERVAL_SECONDS=600
# PARTNA_SESSION_MAX_LIFETIME_SECONDS=2592000

# Anti-bot form timing (ms) — min fill time / max stale-form age
# PARTNA_FORM_TIMING_MIN_MS=2500
# PARTNA_FORM_TIMING_MAX_MS=43200000

# Queue lane names (config/partna.php — each must match a Horizon supervisor)
# PARTNA_ANALYTICS_QUEUE=analytics
# PARTNA_MODERATION_HIGH_LANE=moderation_high

# Design-kit column-cache version — bump in the SAME migration PR that adds or
# drops a site.design_kits column.
# PARTNA_DESIGN_KIT_COLUMNS_VERSION=1

# GDPR user data export (Articles 15/20 — erasure & portability)
PARTNA_GDPR_QUEUE=gdpr
GDPR_QUEUE_RETRY_AFTER=660
# PARTNA_GDPR_QUEUE_RETRY_AFTER overrides GDPR_QUEUE_RETRY_AFTER for the gdpr connection.
# PARTNA_GDPR_QUEUE_RETRY_AFTER=660
# PARTNA_GDPR_QUEUE_BLOCK_FOR=5   # BLPOP wait in seconds; never 0 (blocks SIGTERM, breaks deploys)
# PARTNA_EXPORT_MAX_ROWS=50000
# GDPR_EXPORT_SIGNED_URL_TTL_DAYS=7
# GDPR_EXPORT_DEDUP_WINDOW_MINUTES=30
GDPR_REDACT_PLACEHOLDER_DOMAIN=gdpr.partna.au
GDPR_EXPORT_RETENTION_DAYS=30

# Streaming platform API credentials (for live status polling)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Apify Instagram profile-scraper (pilot). Legacy stub — null is safe (feature
# off); listed so the key isn't silently consumed by accident.
# APIFY_TOKEN=

# Cloudflare KV + cache purge. KV holds the Edge Worker routing table
# (written by SyncSubdomainToKvJob); the scoped API token also drives
# edge cache invalidation after site mutations.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
# Scoped token with only Zone.Cache Purge permission on the partna.au zone.
# Used by CloudflarePurgeService to invalidate individual public profile
# pages at the edge after site mutations.
CLOUDFLARE_CACHE_PURGE_TOKEN=
# Cloudflare for SaaS custom-domain provisioning (commit 028a5d09). Token scopes:
# Zone:SSL, Certificates:Edit, Zone:Read. Null → custom-domain ops disabled.
# CLOUDFLARE_SAAS_API_TOKEN=
# CLOUDFLARE_SAAS_CNAME_TARGET=cname.partna.au

# Google Maps / Places — client-safe key returned (CDN-cached, public) at
# GET /api/public/config/integrations for the dashboard's address autocomplete.
# It MUST be HTTP-referrer-restricted to *.partna.au/* in the Google Cloud
# Console — that restriction is the ONLY thing keeping a public key safe.
# Re-verify it after every key rotation and on every fresh-environment deploy.
GOOGLE_MAPS_API_KEY=

# Server-side Google key for google-business Place Details enrichment (rating,
# reviews, hours, photos). API-restricted to Places API (New) in the Cloud
# Console; no referrer restriction (server-to-server). Never exposed publicly.
GOOGLE_MAPS_SERVER_API_KEY=

# Instagram / Apify scraper cost controls (pilot). Per-user re-scrape cooldown
# and the global daily run cap for the paid Apify scraper. Tune without a deploy.
PARTNA_INSTAGRAM_APIFY_COOLDOWN_SECONDS=600
PARTNA_INSTAGRAM_APIFY_DAILY_CAP=200

# Shared Apify cost ceiling (SCALE-2). Per-actor daily caps + global daily cap.
PARTNA_APIFY_GLOBAL_DAILY_CAP=1000
PARTNA_MENU_APIFY_DAILY_CAP=300
PARTNA_GB_APIFY_DAILY_CAP=300

# Google Places (New) spend ceiling (RV-6) — global + per-SKU + per-user daily
# caps, enforced per BILLED request (one fetchPlaceDetails() issues up to 16).
PARTNA_PLACES_GLOBAL_DAILY_CAP=500
PARTNA_PLACES_USER_DAILY_CAP=60
PARTNA_PLACES_DETAILS_DAILY_CAP=200
PARTNA_PLACES_PHOTOS_DAILY_CAP=400

# R4-RES-1: negative-cache TTL for a menu scrape target that came back empty /
# bot-blocked, before it may be re-billed. Kept below the menu:retry-unavailable
# 15-min cadence.
PARTNA_MENU_BLOCKED_TTL_SECONDS=600

# Lander::land() batch size (SCALE-4). Records per chunk transaction; a chunk
# that fails falls back to per-record landing. 500 leaves an order of
# magnitude of headroom under Postgres's 65,535 bind/statement limit.
PARTNA_INGEST_LAND_CHUNK=500

# Fresha booking GraphQL — persisted-query hash + client version, pinned to a
# Fresha frontend build. They rotate when Fresha redeploys (every few weeks);
# update these without a code deploy when fetchEmployeeServices starts failing
# (see the fresha.employee_services.failed Nightwatch log). Defaults in
# config/services.php keep the app working when unset.
FRESHA_BOOKING_INIT_HASH=
FRESHA_CLIENT_VERSION=

# Seconds a scraped Fresha team roster is served from payload.teamMenuCache before re-scraping (default 86400).
# PARTNA_FRESHA_TEAM_CACHE_SECONDS=86400

# Moderation (Trust & Safety) — see docs/moderation/README.md
# Master switch for the moderation feature (reporting, staff queue, outcomes).
PARTNA_MODERATION_ENABLED=true
# Emergency kill-switch for automated enforcement (e.g. the CSAM auto-action
# pipeline). When false, CSAM matches still preserve evidence + file the NCMEC
# CyberTip, but the automated suspend/quarantine/hide decision is NOT dispatched
# — the case is left open for manual staff handling. Keep true; flip to false
# only during an incident.
PARTNA_MODERATION_AUTO_ACTIONS_ENABLED=true
# RV-10: TTL (seconds) for the per-recipient send-dedup marker in the Notify*
# jobs — must outlive every automatic retry window. Default 7 days.
# PARTNA_MODERATION_NOTIFY_MARKER_TTL=604800

# Bot protection foundation — see docs/superpowers/specs/2026-05-26-bot-protection-foundation-design.md
BOT_PROTECTION_DRIVER=null          # null | turnstile | hcaptcha. Default null for local; set to turnstile in deployed envs.
BOT_PROTECTION_MODE=shadow          # off = disabled (local only); shadow = verify + log, never reject; enforce = verify + reject on failure. Recommended: shadow for staging, enforce for production.
BOT_PROTECTION_FAIL_OPEN=false      # Fail CLOSED by default: when the CAPTCHA provider or the Redis circuit-breaker is unreachable in `enforce` mode, requests get 503 captcha_unavailable rather than passing. Set to `true` only as a deliberate, temporary incident-response measure on a named environment. Has no effect when BOT_PROTECTION_MODE=off|shadow — shadow never rejects regardless (VerifyBotToken::failOpenOrReject).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# Shared-secret token for the GET /api/internal/env-check self-diagnostic endpoint.
# When unset, the endpoint returns 503 (fail-closed). Set this on Laravel Cloud
# to enable remote env-var verification, then hit the URL with the matching
# X-Internal-Token header. Use a strong random value, e.g. `openssl rand -hex 32`.
INTERNAL_ENV_CHECK_TOKEN=
