APP_NAME=Laravel
APP_ENV=local
APP_KEY=EXAMPLE
APP_DEBUG=false
APP_URL=http://localhost:8000

# Public mini-site domain. Individual sites resolve as {handle}.{PARTNA_PUBLIC_DOMAIN}.
# Production: partna.au. Local dev: leave unset to fall through to APP_URL host.
# Legacy fallback SIDEST_PUBLIC_DOMAIN is also read (deprecated).
# PARTNA_PUBLIC_DOMAIN=partna.au

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Nightwatch — observability. Slow-route / slow-query / slow-job alert
# thresholds are set in the Nightwatch dashboard, not here. The knobs below
# control what events are captured and shipped. See config/nightwatch.php.
NIGHTWATCH_TOKEN=your-nightwatch-token-here
# NIGHTWATCH_ENABLED=true
# NIGHTWATCH_DEPLOY=
# NIGHTWATCH_CAPTURE_EXCEPTION_SOURCE_CODE=true
# NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=false
# NIGHTWATCH_REDACT_PAYLOAD_FIELDS=_token,password,password_confirmation
# NIGHTWATCH_REDACT_HEADERS=Authorization,Cookie,Proxy-Authorization,X-XSRF-TOKEN
# Sampling rates (1.0 = all, 0.1 = 10%). Drop request rate first under load; keep exceptions at 1.0.
# NIGHTWATCH_REQUEST_SAMPLE_RATE=1.0
# NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
# NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
# NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=1.0
# Filtering — drop noisy event categories once volume is high.
# NIGHTWATCH_IGNORE_CACHE_EVENTS=false
# NIGHTWATCH_IGNORE_QUERIES=false
# NIGHTWATCH_IGNORE_MAIL=false
# NIGHTWATCH_IGNORE_NOTIFICATIONS=false
# NIGHTWATCH_IGNORE_OUTGOING_REQUESTS=false
# NIGHTWATCH_LOG_LEVEL=debug
# Ingest agent (Laravel Cloud runs the daemon locally).
# NIGHTWATCH_INGEST_URI=127.0.0.1:2407
# NIGHTWATCH_INGEST_TIMEOUT=0.5
# NIGHTWATCH_INGEST_CONNECTION_TIMEOUT=0.5
# NIGHTWATCH_INGEST_EVENT_BUFFER=500

# Horizon dashboard. The auth gate (AppServiceProvider::authorizeHorizonRequest)
# is open in non-production and sealed in production by default. To allow
# production access, set BOTH credentials below — the dashboard then requires
# HTTP Basic auth. Leaving either unset keeps prod sealed. Use a long random
# password; this gates access to job payloads and a retry button.
# HORIZON_DASHBOARD_USERNAME=
# HORIZON_DASHBOARD_PASSWORD=

# Horizon long-wait notifications. Thresholds are per-queue in config/horizon.php
# 'waits'. These alert on queue *backlog* (jobs sitting too long); Nightwatch
# already covers job *exceptions*. Mail and Slack are independent.
# HORIZON_NOTIFICATION_EMAIL=
# HORIZON_NOTIFICATION_SLACK_WEBHOOK=
# HORIZON_NOTIFICATION_SLACK_CHANNEL=

# Horizon dashboard URL — default '/horizon'. Set HORIZON_DOMAIN to pin the
# dashboard to a specific subdomain (useful when the API is behind multiple hosts).
# HORIZON_PATH=horizon
# HORIZON_DOMAIN=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Separate cache vs sessions vs queues vs locks. DB 0 (REDIS_DB) is reserved
# for Horizon/queue traffic — keep cache OFF it: Cache::flush() issues a raw
# FLUSHDB that is NOT key-prefix-scoped and would wipe Horizon job state.
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_CACHE_LOCKS_DB=4

# igbinary serializer + LZ4 compression on the cache connection (~3× memory reduction).
# Enable only after: (1) confirming phpredis compiled with igbinary+LZ4 via phpinfo(),
# and (2) flushing the Redis cache on deploy (serializer change invalidates existing entries).
# Trigger: median cached payload > ~10KB or Redis memory > ~1GB.
REDIS_IGBINARY=false

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@partna.au"
MAIL_FROM_NAME="${APP_NAME}"

# In-app feedback system (see docs/superpowers/plans/2026-05-25-feedback-system.md).
# Comma-separated email recipients for submission notifications.
# Empty → submissions still persist; email job logs a warning and returns.
FEEDBACK_NOTIFY_EMAILS=
# SHA256 pepper for IP hashing. Generate per env: `openssl rand -hex 32`.
# Never share between envs; never commit. Empty → ip_hash stored NULL.
FEEDBACK_IP_HASH_PEPPER=
# Per-user rate limits. Env-tunable without a code change.
FEEDBACK_RATE_LIMIT_HOUR=10
FEEDBACK_RATE_LIMIT_DAY=30
FEEDBACK_DUPLICATE_WINDOW=60

# Resend HTTP API key — required when MAIL_MAILER=resend. Get from
# https://resend.com/api-keys. Use a "Full access" key so bounce/complaint
# webhooks can be wired up later.
RESEND_API_KEY=

# Supabase Send Email Hook signing secret. Set this from the Supabase
# Dashboard → Authentication → Hooks → Send Email Hook page. Format:
# `v1,whsec_<base64-bytes>`. Without it, /internal/email-hooks/supabase
# returns 503 (fail-closed). Rotate by generating a new secret in Supabase
# and updating this var; Standard Webhooks supports space-separated
# signatures for zero-downtime rotation.
SUPABASE_EMAIL_HOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media disk (Cloudflare R2 / Laravel Cloud Object Storage)
# All images AND videos (originals, variants, HLS segments, posters) go in this bucket.
MEDIA_DISK_KEY=
MEDIA_DISK_SECRET=
MEDIA_DISK_REGION=auto
MEDIA_DISK_BUCKET=sidest-media
MEDIA_DISK_URL=https://media.yourdomain.com
MEDIA_DISK_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
MEDIA_DISK_PATH_STYLE=false
PARTNA_MEDIA_DISK=media

VITE_APP_NAME="${APP_NAME}"

DB_CONNECTION=pgsql
DB_HOST=EXAMPLE
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=EXAMPLE
DB_SSLMODE=require
DB_SEARCH_PATH=public,core,site,notifications,analytics

SUPABASE_URL=EXAMPLE
SUPABASE_ANON_KEY=EXAMPLE
SUPABASE_JWKS_URL=EXAMPLE
SUPABASE_JWT_ISSUER=EXAMPLE
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWKS_CACHE_SECONDS=3600
SUPABASE_JWKS_FAIL_CLOSED=true
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_HOOK_SECRET=
SUPABASE_ADMIN_BASE_URL=

# MFA windows and brute-force protection (see config/partna.php mfa block)
SIDEST_MFA_FRESH_WINDOW_SECONDS=300
SIDEST_MFA_UNENROLL_WINDOW_SECONDS=60
SIDEST_MFA_VERIFY_MAX_FAILURES=5
SIDEST_MFA_VERIFY_WINDOW_SECONDS=300
SIDEST_MFA_REQUIRE_FRESH_AAL2_FOR_PROFILE_UPDATE=false

PARTNA_SOFT_DELETE_RETENTION_DAYS=30
PARTNA_THROTTLE_ENABLED=true

# Comma-separated browser origins allowed to call the API via CORS. No spaces,
# no trailing slashes, no paths. Wildcard subdomains (*.partna.au visitor sites,
# Shopify admin hosts) are matched by patterns in config/cors.php and do NOT
# belong here. Localhost entries belong in dev only.
# Prod example: https://partna.au,https://www.partna.au,https://app.partna.au
# Dev example:  https://partna.au,https://www.partna.au,https://app.partna.au,https://dev-app.partna.au,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
PARTNA_FRONTEND_ORIGINS=
PARTNA_WAITLIST_ENABLED=false
# When true, individual signups with no invite token are diverted to a
# waitlist row instead of creating a user account.
SIDEST_INDIVIDUAL_WAITLIST_ENABLED=false

# Launch feature flags — default false; flip on when feature is ready to ship
PARTNA_SMART_BOOKING_ENABLED=false
PARTNA_SQUARE_SYNC_ENABLED=false
PARTNA_FRESHA_SYNC_ENABLED=false

# Image upload limits
PARTNA_IMAGE_MAX_UPLOAD_KB=10240
PARTNA_GALLERY_IMAGE_MAX=5
PARTNA_CONTENT_IMAGE_MAX=5

# Image processing variants
PARTNA_IMAGE_TARGET_KB=500
PARTNA_IMAGE_QUALITY=92
PARTNA_IMAGE_MIN_QUALITY=60
PARTNA_IMAGE_MAXIMIZED_QUALITY=92

# Video uploads (set PARTNA_VIDEO_UPLOADS_ENABLED=true only after video workers are running)
PARTNA_VIDEO_UPLOADS_ENABLED=false
PARTNA_VIDEO_MAX_UPLOAD_KB=512000
PARTNA_VIDEO_MAX_DURATION_SECONDS=300
# Defaults assume ffmpeg/ffprobe on $PATH (local dev via Homebrew/Herd).
# On Laravel Cloud, override in the dashboard with the absolute paths
# installed by deploy/ffmpeg.sh:
#   PARTNA_FFMPEG_BINARY=/var/www/html/bin/ffmpeg/ffmpeg
#   PARTNA_FFPROBE_BINARY=/var/www/html/bin/ffmpeg/ffprobe
PARTNA_FFMPEG_BINARY=ffmpeg
PARTNA_FFPROBE_BINARY=ffprobe
PARTNA_VIDEO_QUEUE_CONNECTION=redis_video
PARTNA_VIDEO_QUEUE_NAME=videos
PARTNA_VIDEO_QUEUE_TIMEOUT=3600
PARTNA_VIDEO_QUEUE_RETRY_AFTER=3600
PARTNA_VIDEO_OPTIMIZED_RESOLUTION=1280x720
PARTNA_VIDEO_OPTIMIZED_BITRATE=2000
PARTNA_VIDEO_OPTIMIZED_AUDIO_BITRATE=128
PARTNA_VIDEO_MAXIMIZED_RESOLUTION=1920x1080
PARTNA_VIDEO_MAXIMIZED_BITRATE=5000
PARTNA_VIDEO_MAXIMIZED_AUDIO_BITRATE=192

PARTNA_NOTIFICATIONS_EMAIL_ENABLED=false

# ── Operational tuning knobs ─────────────────────────────────
# All have safe defaults in config/partna.php — listed here (commented)
# for discoverability during incident response. Uncomment to override.

# Cache TTLs (seconds)
# PARTNA_CACHE_TTL_PUBLIC_PAYLOAD=900
# PARTNA_CACHE_TTL_ANALYTICS_SHORT=300
# PARTNA_CACHE_TTL_AUTH_ID_LOOKUP=1800
# PARTNA_CACHE_TTL_PROFESSIONAL_MODEL=60
# PARTNA_CACHE_TTL_PROFESSIONAL_HANDLE_LOOKUP=3600
# PARTNA_CACHE_TTL_WEBHOOK_IDEMPOTENCY=86400
# PARTNA_NOTIFICATIONS_LISTING_CACHE_TTL=15

# Retention windows (days)
# PARTNA_ANALYTICS_RAW_EVENT_RETENTION_DAYS=90

# Rate limits / batch sizes
# PARTNA_ENQUIRY_NOTIFY_PER_HOUR=10
# PARTNA_NOTIFICATIONS_BATCH_CHUNK_SIZE=200
# PARTNA_STREAMING_MAX_LIVE_CHECK_PER_SITE=5

# Image / media limits
# PARTNA_IMAGE_MAX_PIXELS=24000000

# Anti-bot form timing (ms) — min fill time / max stale-form age
# PARTNA_FORM_TIMING_MIN_MS=2500
# PARTNA_FORM_TIMING_MAX_MS=43200000

# GDPR user data export (Articles 15/20 — erasure & portability)
PARTNA_GDPR_QUEUE=gdpr
GDPR_QUEUE_RETRY_AFTER=660
GDPR_REDACT_PLACEHOLDER_DOMAIN=gdpr.sidest.io
GDPR_EXPORT_RETENTION_DAYS=30

# Streaming platform API credentials (for live status polling)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Cloudflare KV + cache purge. KV holds the Edge Worker routing table
# (written by SyncSubdomainToKvJob); the scoped API token also drives
# edge cache invalidation after site mutations.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
# Scoped token with only Zone.Cache Purge permission on the partna.au zone.
# Used by CloudflarePurgeService to invalidate individual public profile
# pages at the edge after site mutations.
CLOUDFLARE_CACHE_PURGE_TOKEN=

# Bot protection foundation — see docs/superpowers/specs/2026-05-26-bot-protection-foundation-design.md
BOT_PROTECTION_DRIVER=null          # null | turnstile | hcaptcha. Default null for local; set to turnstile in deployed envs.
BOT_PROTECTION_MODE=off             # off | shadow | enforce. Default off locally; set enforce in deployed envs.
BOT_PROTECTION_FAIL_OPEN=true       # Pre-pilot default; revisit fail-closed per sensitive surface after first real incident.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# Shared-secret token for the GET /api/internal/env-check self-diagnostic endpoint.
# When unset, the endpoint returns 503 (fail-closed). Set this on Laravel Cloud
# to enable remote env-var verification, then hit the URL with the matching
# X-Internal-Token header. Use a strong random value, e.g. `openssl rand -hex 32`.
INTERNAL_ENV_CHECK_TOKEN=
