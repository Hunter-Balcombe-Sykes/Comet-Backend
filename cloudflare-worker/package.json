{
  "name": "partna-subdomain-router",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that routes *.partna.au — individual sitepages render via the partna-pages service binding behind the edge cache, renamed handles 301 to canonical, reserved labels pass through to origin.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types --include-runtime --strict-vars false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "biome format --write .",
    "format:check": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "eslint": "^10.8.0",
    "typescript": "~7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
