+// #SEC-6: a short link's destination can carry a secret-bearing param
+// (?token=...) that expandIfShort() cached verbatim for a full day. Mocks
+// SafeUrlFetcher directly (same pattern as the CCH-2 tests above) so the
+// value handed to Cache::put and returned to the caller can be asserted in
+// one place.
+it('redacts a secret-bearing param in the expanded destination before caching or returning it', function () {
+    $url = 'https://on.soundcloud.com/secret-code';
+    $key = 'shortlink:'.sha1($url);
+
+    $lock = Mockery::mock(Lock::class);
+    $lock->shouldReceive('block')->with(2)->once();
+    $lock->shouldReceive('release')->once()->andReturn(true);
+
+    // Initial miss, then the post-lock double-check (also a miss) — same
+    // shape as the CCH-2 tests above.
+    Cache::shouldReceive('get')->with($key)->twice()->andReturn(null, null);
+    Cache::shouldReceive('lock')->with('lock:'.$key, 20)->once()->andReturn($lock);
+    // The key survives, the value does not — SecretParams::redactUrl()
+    // replaces in place rather than dropping the pair (a dropped pair needs
+    // separator repair; see its docblock).
+    Cache::shouldReceive('put')
+        ->with($key, 'https://soundcloud.com/sam-akhurst?token=[redacted]&ref=clipboard', Mockery::type('int'))
+        ->once();
+
+    $this->mock(SafeUrlFetcher::class, function ($m) {
+        $m->shouldReceive('tryFetch')->once()->andReturn([
+            'finalUrl' => 'https://soundcloud.com/sam-akhurst?token=eyJhbGciOiJIUzI1NiJ9.abcdefgh.signature&ref=clipboard',
+        ]);
+    });
+
+    $expanded = app(ShortLinkExpander::class)->expandIfShort($url);
+
+    expect($expanded)->toBe('https://soundcloud.com/sam-akhurst?token=[redacted]&ref=clipboard')
+        ->and($expanded)->toContain('sam-akhurst')
+        ->and($expanded)->not->toContain('eyJhbGciOiJIUzI1NiJ9');
+});
+
+it('leaves an expansion with no secret-shaped params unmangled', function () {
+    $pro = createTenant('shortlink-nosecret');
+
+    Http::fake([
+        'on.soundcloud.com/*' => Http::response('', 302, ['Location' => 'https://soundcloud.com/sam-akhurst?ref=clipboard&utm_source=ig']),
+        'soundcloud.com/*' => Http::response('ok', 200, ['Content-Type' => 'text/html']),
+    ]);
+
+    $expanded = app(ShortLinkExpander::class)->expandIfShort('https://on.soundcloud.com/no-secret-code');
+
+    expect($expanded)->toBe('https://soundcloud.com/sam-akhurst?ref=clipboard&utm_source=ig');
+});
+
