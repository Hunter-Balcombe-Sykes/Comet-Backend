.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
# Redundant with storage/logs/.gitignore (`*` + `!.gitignore`), which already ignores
# the directory's contents — but that nested file is one `rm` away from taking the
# protection with it, and Checkpoint's GitIgnoreCheck only str_contains-matches THIS
# file, so it cannot see the nested one. The negation keeps the tracked .gitignore.
/storage/logs/*
!/storage/logs/.gitignore
/storage/pail
/vendor
/.worktrees
Homestead.json
Homestead.yaml
Thumbs.db
.DS_Store
._*

# DeepSeek/adjudicate scan intermediates — only the final adjudicated CONSOLIDATED.md is a deliverable
audits/.drafts/
audits/**/.drafts/
audits/**/.drafts/

# AI tooling config — not deployable
.junie/
.mcp.json
boost.json
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/dast-maintenance-check.sh
.claire/
claude-overnight.log

# Editor / REPL scratch noise
*.swp
.Rhistory

# ffmpeg binaries installed by deploy/ffmpeg.sh at build time
/bin/
.wrangler/
scripts/launch-check/.env
scripts/dast/.env

# launch-check run output — a local diagnostic artefact, never a deliverable.
# The report embeds each probe's verbatim output (cloud CLI payloads, exception
# messages), so it must never be committable even though those paths are now
# truncated/redacted at the source.
audits/launch-check/
.env.drill
.env.testing
.env.backup-*
